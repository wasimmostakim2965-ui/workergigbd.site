# Copy this file to .env and fill in real values. The real .env is gitignored.

# Google Analytics measurement id (public)
VITE_GA_ID=

# Supabase project URL and anon (public, RLS-protected) key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ImgBB API key used for disposable public images (task proofs, job images,
# ad banners). Public by product decision; upload happens directly in the browser.
VITE_IMGBB_API_KEY=

# Optional: canonical redirect URL used for auth callbacks
VITE_AUTH_REDIRECT_URL=

# Local/server-only Postgres connection string — NEVER expose to the browser,
# and NEVER prefix with VITE_. Not used by the frontend bundle.
# DATABASE_URL=
